{
  "manifest_version": 3,
  "name": "BayBuddy",
  "version": "0.1.0",
  "description": "Your smart eBay companion — hide collection-only listings, filter by location, search sold items, and view price analytics.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.ebay.co.uk/*",
    "https://www.ebay.com/*",
    "https://www.ebay.com.au/*",
    "https://www.ebay.ca/*",
    "https://www.ebay.de/*",
    "https://www.ebay.fr/*",
    "https://www.ebay.it/*",
    "https://www.ebay.es/*",
    "https://www.ebay.ie/*",
    "https://www.ebay.nl/*",
    "https://www.ebay.at/*",
    "https://www.ebay.ch/*",
    "https://www.ebay.pl/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.co.uk/sch/*",
        "https://www.ebay.com/sch/*",
        "https://www.ebay.com.au/sch/*",
        "https://www.ebay.ca/sch/*",
        "https://www.ebay.de/sch/*",
        "https://www.ebay.fr/sch/*",
        "https://www.ebay.it/sch/*",
        "https://www.ebay.es/sch/*",
        "https://www.ebay.ie/sch/*",
        "https://www.ebay.nl/sch/*",
        "https://www.ebay.at/sch/*",
        "https://www.ebay.ch/sch/*",
        "https://www.ebay.pl/sch/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.co.uk/itm/*",
        "https://www.ebay.com/itm/*",
        "https://www.ebay.com.au/itm/*",
        "https://www.ebay.ca/itm/*",
        "https://www.ebay.de/itm/*",
        "https://www.ebay.fr/itm/*",
        "https://www.ebay.it/itm/*",
        "https://www.ebay.es/itm/*",
        "https://www.ebay.ie/itm/*",
        "https://www.ebay.nl/itm/*",
        "https://www.ebay.at/itm/*",
        "https://www.ebay.ch/itm/*",
        "https://www.ebay.pl/itm/*"
      ],
      "js": ["itm.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

{
  "compilerOptions": {
    "target": "ES2016",
    "lib": ["DOM", "ES2017", "DOM.Iterable"],
    "module": "ES2015",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["chrome", "jest"]
  },
  "include": ["src/**/*"]
}
